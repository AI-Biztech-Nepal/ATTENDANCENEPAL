SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
# Don't hand-fill these two — generate them from the dashboard's Devices page
# ("+ Generate Bridge Credentials" -> "Download .env"). Each credential is a
# real Supabase Auth user scoped to exactly one company via RLS, so this file
# is the whole thing you need — no service-role key or company id here.
BRIDGE_EMAIL=bridge-xxxxxxxx@device-bridge.internal
BRIDGE_PASSWORD=your-generated-password
SYNC_INTERVAL_MS=15000
