{
  "name": "attendance-nepal-desktop",
  "version": "1.0.9",
  "description": "Attendance Nepal admin dashboard as a Windows desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "electron-updater": "^6.8.9",
    "node-zklib": "^1.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.attendancenepal.desktop",
    "productName": "Attendance Nepal",
    "publish": {
      "provider": "generic",
      "url": "https://attendance-nepal.com/desktop-updates/"
    },
    "files": [
      "main.js",
      "lan-bridge.js",
      "preload-settings.js",
      "settings.html",
      "settings-renderer.js",
      "package.json",
      "build/icon.png",
      "build/icon.ico"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
