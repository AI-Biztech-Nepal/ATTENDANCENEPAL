EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Polled by src/lib/useUpdateCheck.ts on launch — point this at your admin-web
# Vercel deployment, which serves admin-web/public/mobile-update.json.
# (src/lib/useUpdateCheck.ts already falls back to the real production domain
# below if this isn't set, so it's optional unless you're pointing at a
# different deployment.)
EXPO_PUBLIC_UPDATE_CHECK_URL=https://attendancenepal.vercel.app/mobile-update.json
