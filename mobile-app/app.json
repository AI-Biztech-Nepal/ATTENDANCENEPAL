{
  "expo": {
    "name": "Attendance",
    "slug": "attendance-mobile",
    "version": "1.0.114",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Used to take a selfie or scan a QR code for attendance check-in.",
        "NSLocationWhenInUseUsageDescription": "Used to confirm you're at your branch when checking in.",
        "NSPhotoLibraryUsageDescription": "Used to choose an employee profile photo."
      }
    },
    "android": {
      "package": "com.attendancenepal.mobile",
      "versionCode": 114,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Attendance Nepal to use Face ID to unlock the app."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to choose an employee profile photo.",
          "cameraPermission": "Used to take an employee profile photo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0d9488"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "460a2da0-e33b-4dd6-8dfd-7457d1e46753"
      }
    },
    "owner": "aibiztechnepal"
  }
}
